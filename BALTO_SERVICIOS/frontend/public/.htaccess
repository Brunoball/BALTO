Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /BALTO_SERVICIOS/

  RewriteRule ^api(?:/|$) - [L,NC]
  RewriteRule ^dev-auth-start\.html$ - [L,NC]
  RewriteRule ^dev-auth-finish\.html$ - [L,NC]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(?:index\.html|dev-auth-start\.html|dev-auth-finish\.html)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(?:js|css|woff2?|ttf)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:png|jpe?g|svg|ico|webp|gif)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>

  <FilesMatch "^(?:manifest\.json|robots\.txt)$">
    Header always set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml image/svg+xml
</IfModule>
