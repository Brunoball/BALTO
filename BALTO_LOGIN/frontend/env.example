# API central del BALTO_LOGIN.
# LOCAL (si levantás BALTO_LOGIN/api con PHP en el puerto 3001):
REACT_APP_API_URL=http://localhost:3001/routes

# En producción podés borrar REACT_APP_API_URL y config.jsx usará:
# https://balto.3devsnet.com/BALTO_LOGIN/api/routes

# Router del frontend de login.
# Local con npm start: /
# Producción dentro de balto.3devsnet.com/BALTO_LOGIN/: /BALTO_LOGIN
REACT_APP_ROUTER_BASENAME=/

# Opcional para compartir cookies entre subdominios. Para subcarpetas del
# mismo dominio no hace falta configurarlo.
REACT_APP_COOKIE_DOMAIN=
